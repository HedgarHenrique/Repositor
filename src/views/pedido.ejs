<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitar Reposição</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .card { background-color: #1e293b; border-radius: 12px; border: 1px solid #334155; padding: 30px; width: 100%; max-width: 500px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); }
        .card-header { text-align: center; margin-bottom: 25px; border-bottom: 1px solid #334155; padding-bottom: 15px; }
        .card-header h2 { font-size: 22px; color: #f8fafc; margin-bottom: 5px; }
        .card-header p { color: #94a3b8; font-size: 14px; }
        label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #cbd5e1; }
        input, select, textarea { width: 100%; padding: 12px; background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; color: white; margin-bottom: 20px; font-size: 14px; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: #3b82f6; }
        textarea { resize: none; }
        .btn { width: 100%; padding: 14px; background-color: #10b981; color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 16px; cursor: pointer; }
        .btn:hover { background-color: #059669; }
        .footer-link { text-align: center; margin-top: 15px; }
        .footer-link a { color: #3b82f6; text-decoration: none; font-size: 14px; font-weight: 500; }
    </style>
</head>
<body>

    <div class="card">
        <div class="card-header">
            <h2>📦 Solicitar Reposição</h2>
            <p>Envie as necessidades de estoque para o comprador</p>
        </div>
        
        <form action="/enviar-pedido" method="POST">
            <label for="funcionario">Seu Nome (Funcionário)</label>
            <input type="text" id="funcionario" name="funcionario" placeholder="Ex: Hedgar" required>

            <label for="loja">Para qual local é o pedido?</label>
            <select id="loja" name="loja" required>
                <option value="" disabled selected>Escolha o estabelecimento</option>
                <option value="Bar">🍺 Bar</option>
                <option value="Tabacaria">🚬 Tabacaria</option>
            </select>

            <label for="quantidade">Quantidade Necessária</label>
            <input type="number" id="quantidade" name="quantidade" min="1" placeholder="Ex: 5" required>

            <label for="descricao">Mercadoria / Item Especificado</label>
            <textarea id="descricao" name="descricao" rows="3" placeholder="Ex: Cerveja Heineken Latão..." required></textarea>

            <button type="submit" class="btn">Enviar Requisição</button>
        </form>

                        <div class="footer-link">
            <button onclick="acessarComPin()" style="background: none; border: none; color: #3b82f6; text-decoration: none; font-size: 14px; font-weight: 500; cursor: pointer;">📊 Acessar Painel do Gerente</button>
        </div>
    </div>

    <script>
        function acessarComPin() {
            const pin = prompt('Digite o PIN de 4 dígitos para acessar o painel:');
            if (pin) {
                window.location.href = '/gerente?pin=' + pin;
            }
        }
    </script>




    </div>

</body>
</html>
