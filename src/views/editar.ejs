<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Pedido</title>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background-color: #1e293b; border-radius: 12px; border: 1px solid #334155; padding: 30px; width: 90%; max-width: 450px; }
        h3 { margin-bottom: 20px; font-size: 20px; text-align: center; }
        label { display: block; margin-bottom: 8px; font-weight: bold; font-size: 14px; color: #94a3b8; }
        input, select { width: 100%; padding: 10px; background-color: #0f172a; border: 1px solid #334155; border-radius: 6px; color: white; margin-bottom: 15px; font-size: 14px; }
        .btn-group { display: flex; gap: 10px; margin-top: 10px; }
        .btn { flex: 1; padding: 12px; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; text-align: center; text-decoration: none; font-size: 14px; }
        .btn-success { background-color: #10b981; color: white; }
        .btn-cancel { background-color: #64748b; color: white; }
    </style>
</head>
<body>

    <div class="card">
        <h3>✏️ Editar Requisição</h3>
        <form action="/pedido/<%= pedido.id %>/editar" method="POST">
            <label>Funcionário</label>
            <input type="text" name="funcionario" value="<%= pedido.funcionario %>" required>

            <label>Loja Destino</label>
            <select name="loja" required>
                <option value="Bar" <%= pedido.loja === 'Bar' ? 'selected' : '' %>>Bar</option>
                <option value="Tabacaria" <%= pedido.loja === 'Tabacaria' ? 'selected' : '' %>>Tabacaria</option>
            </select>

            <label>Quantidade</label>
            <input type="number" name="quantidade" value="<%= pedido.quantidade %>" min="1" required>

            <label>Item / Descrição</label>
            <input type="text" name="descricao" value="<%= pedido.descricao %>" required>

            <div class="btn-group">
                <button type="submit" class="btn btn-success">Salvar Alterações</button>
                <a href="/gerente" class="btn btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>

</body>
</html>
